# Copy this file to .env.local and fill in the values.

# Google reCAPTCHA v3 – create keys at https://www.google.com/recaptcha/admin (type: "Score based (v3)").
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Submissions scoring below this (0.0 = bot, 1.0 = human) are rejected.
RECAPTCHA_MIN_SCORE=0.5

# Web app URL of the Google Apps Script in google-apps-script/Code.gs (ends with /exec).
GOOGLE_SCRIPT_URL=
# Must match SHARED_SECRET inside Code.gs.
GOOGLE_SCRIPT_SECRET=
